{
	"compatibility_date": "2026-06-02",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {
		"PUBLIC_SANITY_PROJECT_ID": "e42zgvs8",
		"PUBLIC_SANITY_DATASET": "production"
	},
	"observability": {
		"enabled": true
	}
}
