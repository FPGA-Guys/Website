# Sanity CMS (required for blog + Studio)
# Find these in https://www.sanity.io/manage after creating a project.
PUBLIC_SANITY_PROJECT_ID=your_project_id_here
PUBLIC_SANITY_DATASET=production

# Optional: only needed for draft preview or private datasets.
# SANITY_API_READ_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare Pages
# Add the same PUBLIC_* variables in:
#   Cloudflare dashboard -> Workers & Pages -> your project -> Settings -> Environment variables
#
# After you publish a blog post in Sanity, trigger a new Cloudflare deploy
# (push to GitHub, or use a Sanity webhook) so the site rebuilds with fresh content.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Local setup
# 1. Copy this file:  cp .env.example .env
# 2. Paste your Sanity project ID and dataset name.
# 3. Run: npm run dev
# 4. Open the CMS at http://localhost:4321/admin
# 5. In Sanity Manage, add http://localhost:4321 to CORS origins (authenticated requests).
# ---------------------------------------------------------------------------
