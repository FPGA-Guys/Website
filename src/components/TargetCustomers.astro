---
const prospects = [
	{ name: 'Saputo', sector: 'Dairy', city: 'Saint-Léonard, QC' },
	{ name: 'Lassonde Industries', sector: 'Juice and beverage', city: 'Rougemont, QC' },
	{ name: 'Olymel', sector: 'Pork and poultry', city: 'Multi-site, QC' },
	{ name: 'Bonduelle Canada', sector: 'Frozen and canned vegetables', city: 'Saint-Denis-sur-Richelieu, QC' },
	{ name: 'Lallemand', sector: 'Yeast and biotech fermentation', city: 'Montréal, QC' },
	{ name: 'Cascades', sector: 'Pulp and paper', city: 'Kingsey Falls, QC' },
];
---

<section id="customers" class="relative py-24 md:py-32">
	<div class="container-x">
		<div class="mx-auto max-w-3xl text-center">
			<div data-reveal>
				<span class="section-eyebrow">Quebec beachhead</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight text-white md:text-5xl">
				We start where we have <span class="text-accent">access</span>.
			</h2>
			<p data-reveal data-reveal-delay="2" class="mx-auto mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
				The densest concentration of mid-market food and beverage manufacturers in Canada, all
				within driving distance of our lab.
			</p>
		</div>

		<div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/5 sm:grid-cols-2 lg:grid-cols-3">
			{
				prospects.map((p, i) => (
					<article
						data-reveal
						data-reveal-delay={String((i % 3) + 1)}
						class="group relative bg-[var(--color-bg)] p-6 transition-colors hover:bg-[var(--color-surface)]"
					>
						<div class="flex items-start justify-between gap-3">
							<div>
								<h3 class="text-lg font-semibold text-white">{p.name}</h3>
								<p class="mt-0.5 text-xs tracking-wide text-[var(--color-text-muted)] uppercase">
									{p.sector}
								</p>
							</div>
							<span class="font-mono text-[10px] text-[var(--color-text-dim)]">T1</span>
						</div>
						<p class="mt-4 text-sm text-[var(--color-text-muted)]">{p.city}</p>
					</article>
				))
			}
		</div>

		<div class="mt-10 grid gap-6 md:grid-cols-3">
			{
				[
					{ title: 'Direct outreach', body: 'Through the Gina Cody School\u2019s industry partnerships, Centech, and existing engineering relationships.' },
					{ title: 'Sector events', body: 'AQFP (Quebec Food Processing), IEEE, and CSME chapters where the team holds active leadership roles.' },
					{ title: 'Plant-to-plant referrals', body: 'Once one site is live, expansion across the same parent company is the dominant motion.' },
				].map((item, i) => (
					<div data-reveal data-reveal-delay={String(i + 1)} class="card p-6">
						<h3 class="text-base font-semibold text-white">{item.title}</h3>
						<p class="mt-2 text-sm text-[var(--color-text-muted)]">{item.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
