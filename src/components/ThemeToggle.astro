---
// Theme toggle. CSS in global.css swaps which icon is visible based on
// `html.light` vs default (dark). The script flips that class and persists.
---

<button
	id="theme-toggle"
	type="button"
	class="theme-toggle"
	aria-label="Toggle colour theme"
	title="Toggle light / dark"
>
	<!-- Moon (shown in dark) -->
	<svg class="icon-moon h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a6 6 0 1 0 7 7Z" />
	</svg>
	<!-- Sun (shown in light) -->
	<svg class="icon-sun h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="8" cy="8" r="3" />
		<path d="M8 1.5v1.5M8 13v1.5M1.5 8h1.5M13 8h1.5M3.3 3.3l1.05 1.05M11.65 11.65l1.05 1.05M3.3 12.7l1.05-1.05M11.65 4.35l1.05-1.05" />
	</svg>
</button>

<script is:inline>
	(function () {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		btn.addEventListener('click', () => {
			const root = document.documentElement;
			const wasLight = root.classList.contains('light');
			root.classList.toggle('light', !wasLight);
			root.classList.toggle('dark', wasLight);
			try {
				localStorage.setItem('phasora-theme', wasLight ? 'dark' : 'light');
			} catch (_e) {}
		});
	})();
</script>
