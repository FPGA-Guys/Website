---
const pillars = [
	{
		eyebrow: 'Edge AI',
		title: 'Inference on the sensor.',
		body: 'The anomaly model runs directly on the node. Sub-2 ms inference. Under 5 watts. No round-trip to the cloud.',
	},
	{
		eyebrow: 'Self-installing mesh',
		title: 'Connects itself.',
		body: 'Sensors discover the gateway, the gateway routes itself onto your existing network. Nothing for IT to provision.',
	},
	{
		eyebrow: 'Privacy by design',
		title: 'Your data, on your floor.',
		body: 'Telemetry can stay on-prem indefinitely. The dashboard runs locally. The cloud is optional.',
	},
	{
		eyebrow: 'Integrates where you work',
		title: 'No new dashboard to learn.',
		body: 'Alerts flow into the systems your maintenance team already uses, from CMMS to email to SCADA historians.',
	},
];
---

<section id="tech" class="relative pb-10 md:pb-12">
	<div class="container-x">
		<div class="mx-auto max-w-3xl text-center">
			<div data-reveal>
				<span class="section-eyebrow">Why it works</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight md:text-5xl" style="color: var(--color-text);">
				Four design choices, built for <span class="text-accent">the floor</span>.
			</h2>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-2">
			{
				pillars.map((p, i) => (
					<article data-reveal data-reveal-delay={String((i % 2) + 1)} class="card p-7">
						<div class="text-[10px] tracking-widest uppercase" style="color: var(--color-text-dim);">
							{p.eyebrow}
						</div>
						<h3 class="mt-2 text-xl font-semibold" style="color: var(--color-text);">{p.title}</h3>
						<p class="mt-3 text-sm leading-relaxed" style="color: var(--color-text-muted);">{p.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
