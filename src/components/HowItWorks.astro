---
const steps = [
	{
		num: '01',
		title: 'Bolt on',
		body: 'Magnetic sensor goes on the motor or pump in under 15 minutes. No wiring. No shutdown.',
		spec: ['Vibration . current . acoustic', 'Magnetic or bolt-on mount', '< 15 min per asset'],
		icon: 'sensor',
	},
	{
		num: '02',
		title: 'Detect on device',
		body: 'AI runs on the sensor itself. Under 5 watts. No data leaves the plant.',
		spec: ['On-device AI inference', 'Anomaly detection in real time', '< 5 W, sub-2 ms inference'],
		icon: 'chip',
	},
	{
		num: '03',
		title: 'Connect',
		body: 'A small gateway picks up alerts wirelessly and pipes them into your existing maintenance system.',
		spec: ['Wireless mesh, no new wiring', 'Auto-onboards new sensors', 'Standard CMMS / SAP PM API'],
		icon: 'gateway',
	},
	{
		num: '04',
		title: 'Alert',
		body: 'After 48 hours of baseline learning, any deviation triggers a plain-language alert with a recommended action.',
		spec: ['48h baseline', 'Fault type, severity, action', 'Dashboard, email, or CMMS push'],
		icon: 'alert',
	},
];
---

<section id="how" class="relative py-24 md:py-32">
	<div class="container-x">
		<div class="mx-auto max-w-3xl text-center">
			<div data-reveal>
				<span class="section-eyebrow">How it works</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight text-white md:text-5xl">
				Sensor to <span class="text-accent">alert</span> in four steps.
			</h2>
			<p data-reveal data-reveal-delay="2" class="mx-auto mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
				No cloud round-trip. No data team. No network dependency.
			</p>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((step, i) => (
					<article data-reveal data-reveal-delay={String((i % 4) + 1)} class="card relative overflow-hidden p-6">
						<div class="flex items-start justify-between">
							<div class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-[var(--color-bg)]">
								{step.icon === 'sensor' && (
									<svg class="h-5 w-5 text-[#5eead4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="2.5" />
										<circle cx="12" cy="12" r="6" opacity="0.6" />
										<circle cx="12" cy="12" r="9.5" opacity="0.3" />
									</svg>
								)}
								{step.icon === 'chip' && (
									<svg class="h-5 w-5 text-[#5eead4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
										<rect x="6" y="6" width="12" height="12" rx="2" />
										<path d="M9 9h6v6H9z" />
										<path d="M3 9h3M3 12h3M3 15h3M18 9h3M18 12h3M18 15h3M9 3v3M12 3v3M15 3v3M9 18v3M12 18v3M15 18v3" />
									</svg>
								)}
								{step.icon === 'gateway' && (
									<svg class="h-5 w-5 text-[#5eead4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
										<rect x="3" y="10" width="18" height="9" rx="2" />
										<circle cx="7" cy="14.5" r="0.7" fill="currentColor" />
										<circle cx="10.5" cy="14.5" r="0.7" fill="currentColor" />
										<path d="M12 10V6M8 6c0-2 2-3 4-3s4 1 4 3" />
									</svg>
								)}
								{step.icon === 'alert' && (
									<svg class="h-5 w-5 text-[#5eead4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
										<path d="M3 17h18l-9-13z" />
										<path d="M12 11v3M12 16.5v.5" />
									</svg>
								)}
							</div>
							<span class="font-mono text-sm text-[var(--color-text-dim)]">{step.num}</span>
						</div>

						<h3 class="mt-5 text-lg font-semibold text-white">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{step.body}</p>

						<ul class="mt-5 space-y-2 border-t border-white/5 pt-4">
							{step.spec.map((s) => (
								<li class="flex items-start gap-2 text-xs text-[var(--color-text-muted)]">
									<span class="mt-0.5 inline-flex h-1.5 w-1.5 shrink-0 rounded-full bg-[#2dd4bf]/60" />
									{s}
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>

		<div data-reveal class="mx-auto mt-12 max-w-3xl">
			<div class="flex flex-col items-center gap-3 rounded-2xl border border-[#2dd4bf]/20 bg-[#2dd4bf]/[0.04] px-6 py-5 text-center md:flex-row md:text-left">
				<div class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#2dd4bf]/40 bg-[#04080f]">
					<svg class="h-5 w-5 text-[#5eead4]" viewBox="0 0 16 16" fill="none">
						<path d="M3 8.5L7 12 13 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</div>
				<p class="flex-1 text-sm text-[var(--color-text-muted)]">
					A single prevented failure at a typical food and beverage plant pays back the deployment. <span class="text-white">ROI is immediate.</span>
				</p>
			</div>
		</div>
	</div>
</section>
