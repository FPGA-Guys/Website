---
const steps = [
	{
		num: '01',
		title: 'Sensor node',
		body: 'A magnetic-mount sensor node captures vibration, current draw, and acoustic signatures from rotating assets. Installs in under 15 minutes — no wiring, no specialist, no shutdown.',
		spec: ['Vibration · current · acoustic', 'Magnetic / bolt-on mount', '< 15 min per asset'],
		icon: 'sensor',
	},
	{
		num: '02',
		title: 'On-device AI',
		body: 'An AMD Versal AI Edge FPGA-NPU codesign runs transformer-class anomaly detection directly on the sensor — under 5 watts, in real time. No raw data leaves the plant.',
		spec: ['AMD Versal AI Edge', 'Transformer-class anomaly model', '< 5 W · sub-2 ms inference'],
		icon: 'chip',
	},
	{
		num: '03',
		title: 'Self-installing gateway',
		body: 'A self-configuring gateway (NXP i.MX 8M Plus + LTE-M) auto-onboards new nodes over a BLE 5.4 mesh and pushes structured events to your existing CMMS through a standard API.',
		spec: ['BLE 5.4 mesh · Sub-GHz fallback', 'Auto node onboarding', 'SAP PM · standard CMMS API'],
		icon: 'gateway',
	},
	{
		num: '04',
		title: 'Plain-language alerts',
		body: 'Within 48 hours, the model learns the asset\u2019s normal baseline. Any deviation triggers a timestamped alert with a clear fault description and a recommended next action.',
		spec: ['48h baseline learning', 'Fault type · severity · action', 'Dashboard · email · CMMS push'],
		icon: 'alert',
	},
];
---

<section id="how" class="relative py-28 md:py-36">
	<div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

	<div class="container-x">
		<div class="mx-auto max-w-3xl text-center">
			<div data-reveal>
				<span class="section-eyebrow">How it works</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight md:text-5xl">
				From bolted-on sensor to <span class="text-gradient-accent">actionable alert</span> &mdash; in four steps.
			</h2>
			<p data-reveal data-reveal-delay="2" class="mx-auto mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
				No cloud round-trip. No data-science team. No network dependency. Everything that matters happens on the machine itself.
			</p>
		</div>

		<!-- Steps grid with connecting line -->
		<div class="relative mt-16">
			<!-- Connecting flow line (desktop) -->
			<div class="pointer-events-none absolute top-[3.25rem] left-0 right-0 hidden md:block">
				<svg class="h-2 w-full" preserveAspectRatio="none" viewBox="0 0 1200 8">
					<defs>
						<linearGradient id="flow-grad" x1="0" y1="0" x2="1" y2="0">
							<stop offset="0%" stop-color="#2dd4bf" stop-opacity="0" />
							<stop offset="15%" stop-color="#2dd4bf" stop-opacity="0.6" />
							<stop offset="50%" stop-color="#60a5fa" stop-opacity="0.6" />
							<stop offset="85%" stop-color="#34d399" stop-opacity="0.6" />
							<stop offset="100%" stop-color="#34d399" stop-opacity="0" />
						</linearGradient>
					</defs>
					<line x1="0" y1="4" x2="1200" y2="4" stroke="url(#flow-grad)" stroke-width="1" stroke-dasharray="4 6" />
				</svg>
			</div>

			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{
					steps.map((step, i) => (
						<article data-reveal data-reveal-delay={String((i % 4) + 1)} class="card relative overflow-hidden p-6">
							<span class="glow-ring" />

							<div class="flex items-start justify-between">
								<div class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-[var(--color-bg)]">
									{step.icon === 'sensor' && (
										<svg class="h-5 w-5 text-[#2dd4bf]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
											<circle cx="12" cy="12" r="2.5" />
											<circle cx="12" cy="12" r="6" opacity="0.6" />
											<circle cx="12" cy="12" r="9.5" opacity="0.3" />
										</svg>
									)}
									{step.icon === 'chip' && (
										<svg class="h-5 w-5 text-[#60a5fa]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
											<rect x="6" y="6" width="12" height="12" rx="2" />
											<path d="M9 9h6v6H9z" />
											<path d="M3 9h3M3 12h3M3 15h3M18 9h3M18 12h3M18 15h3M9 3v3M12 3v3M15 3v3M9 18v3M12 18v3M15 18v3" />
										</svg>
									)}
									{step.icon === 'gateway' && (
										<svg class="h-5 w-5 text-[#34d399]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
											<rect x="3" y="10" width="18" height="9" rx="2" />
											<circle cx="7" cy="14.5" r="0.7" fill="currentColor" />
											<circle cx="10.5" cy="14.5" r="0.7" fill="currentColor" />
											<path d="M12 10V6M8 6c0-2 2-3 4-3s4 1 4 3" />
										</svg>
									)}
									{step.icon === 'alert' && (
										<svg class="h-5 w-5 text-[#f59e0b]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
											<path d="M3 17h18l-9-13z" />
											<path d="M12 11v3M12 16.5v.5" />
										</svg>
									)}
								</div>
								<span class="font-mono text-sm text-[var(--color-text-dim)]">{step.num}</span>
							</div>

							<h3 class="mt-5 text-lg font-semibold text-white">{step.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{step.body}</p>

							<ul class="mt-5 space-y-2 border-t border-white/5 pt-4">
								{step.spec.map((s) => (
									<li class="flex items-start gap-2 text-xs text-[var(--color-text-muted)]">
										<span class="mt-0.5 inline-flex h-1.5 w-1.5 shrink-0 rounded-full bg-[#2dd4bf]/60" />
										{s}
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>

		<!-- Outcome callout -->
		<div data-reveal class="mx-auto mt-14 max-w-3xl">
			<div class="flex flex-col items-center gap-3 rounded-2xl border border-[#2dd4bf]/20 bg-[#2dd4bf]/[0.04] px-6 py-5 text-center md:flex-row md:text-left">
				<div class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#2dd4bf]/40 bg-[#04080f]">
					<svg class="h-5 w-5 text-[#2dd4bf]" viewBox="0 0 16 16" fill="none">
						<path d="M3 8.5L7 12 13 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</div>
				<p class="flex-1 text-sm text-[var(--color-text-muted)]">
					A single prevented failure event at a typical food &amp; beverage plant generates savings
					that exceed the entire cost of a MidMon deployment. <span class="text-white">ROI is immediate.</span>
				</p>
			</div>
		</div>
	</div>
</section>
