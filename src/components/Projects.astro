---
const projects = [
	{
		name: 'Helix-1',
		status: 'In production',
		statusColor: 'emerald',
		tag: 'Inference fabric',
		description:
			'A reconfigurable transformer inference fabric for sub-5ms LLM serving at the edge. Currently powering low-latency assistants for two defense and one logistics customer.',
		stats: [
			{ k: 'Latency', v: '3.8ms' },
			{ k: 'Power', v: '38W' },
			{ k: 'Models', v: '4–13B' },
		],
	},
	{
		name: 'Lumen-RT',
		status: 'Closed beta',
		statusColor: 'sky',
		tag: 'Vision pipeline',
		description:
			'Real-time multi-camera perception stack for autonomous systems. Custom CNN dataflow with on-chip Kalman fusion and INT4 quantization-aware training.',
		stats: [
			{ k: 'Streams', v: '16 × 4K' },
			{ k: 'End-to-end', v: '6ms' },
			{ k: 'Detector', v: 'YOLO-v9 / DETR' },
		],
	},
	{
		name: 'Echo-Mesh',
		status: 'Research',
		statusColor: 'fuchsia',
		tag: 'Training cluster',
		description:
			'A scale-out FPGA mesh for sparse-attention training experiments. Hardware-accelerated all-reduce, deterministic replay, and per-tensor power telemetry.',
		stats: [
			{ k: 'Nodes', v: '64' },
			{ k: 'Interconnect', v: '800G RoCE' },
			{ k: 'Sparsity', v: 'up to 90%' },
		],
	},
	{
		name: 'Forge.dev',
		status: 'Coming soon',
		statusColor: 'amber',
		tag: 'Toolchain',
		description:
			'A model-to-bitstream pipeline that lets any PyTorch team target Phasora silicon. Includes a quantization studio, simulator, and OTA deploy runtime.',
		stats: [
			{ k: 'Compile', v: '< 60s' },
			{ k: 'Frameworks', v: 'PyTorch · ONNX' },
			{ k: 'Targets', v: '4 SKUs' },
		],
	},
];

const statusBadge: Record<string, string> = {
	emerald: 'bg-emerald-400/10 text-emerald-300 border-emerald-400/30',
	sky: 'bg-sky-400/10 text-sky-300 border-sky-400/30',
	fuchsia: 'bg-fuchsia-400/10 text-fuchsia-300 border-fuchsia-400/30',
	amber: 'bg-amber-400/10 text-amber-300 border-amber-400/30',
};

const statusDot: Record<string, string> = {
	emerald: 'bg-emerald-400',
	sky: 'bg-sky-400',
	fuchsia: 'bg-fuchsia-400',
	amber: 'bg-amber-400',
};
---

<section id="projects" class="relative py-28 md:py-36">
	<div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

	<div class="container-x">
		<div class="mx-auto flex max-w-3xl flex-col items-center text-center md:mb-16 mb-12">
			<div data-reveal>
				<span class="section-eyebrow">Current projects</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight md:text-5xl">
				What we&rsquo;re shipping <span class="text-gradient-accent">right now</span>.
			</h2>
			<p data-reveal data-reveal-delay="2" class="mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
				A live snapshot of the four products and research tracks running across the lab today.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-2">
			{
				projects.map((project, i) => (
					<article data-reveal data-reveal-delay={String((i % 4) + 1)} class="card group relative overflow-hidden p-7">
						<span class="glow-ring" />
						<!-- Decorative grid -->
						<div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rotate-12 opacity-30 transition-opacity duration-500 group-hover:opacity-70">
							<div class="h-full w-full bg-grid"></div>
						</div>

						<div class="flex items-center justify-between gap-3">
							<div class="flex items-center gap-3">
								<span class="chip">{project.tag}</span>
								<span class={`chip ${statusBadge[project.statusColor]}`}>
									<span class={`h-1.5 w-1.5 rounded-full ${statusDot[project.statusColor]}`} />
									{project.status}
								</span>
							</div>
						</div>

						<h3 class="mt-5 text-2xl font-semibold tracking-tight text-white">{project.name}</h3>
						<p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">{project.description}</p>

						<div class="mt-6 grid grid-cols-3 gap-3">
							{project.stats.map((s) => (
								<div class="rounded-xl border border-white/5 bg-white/[0.02] p-3">
									<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">{s.k}</div>
									<div class="mt-1 font-mono text-sm text-white">{s.v}</div>
								</div>
							))}
						</div>

						<div class="mt-6 flex items-center justify-between border-t border-white/5 pt-5">
							<a href="#" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-muted)] transition-colors hover:text-white">
								Read the technical brief
								<svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
									<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
							<span class="font-mono text-[11px] text-[var(--color-text-dim)]">v0.{i + 4}.1</span>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
