---
interface Props {
	size?: 'header' | 'footer';
	class?: string;
}

const { size = 'header', class: className = '' } = Astro.props;

const sizeClass =
	size === 'footer' ? 'brand-lockup brand-lockup--footer' : 'brand-lockup brand-lockup--header';
---

<span class:list={['brand-lockup-wrap', className]}>
	<img
		src="/brand/phasora-logo-transparent.png"
		alt="Phasora"
		width="200"
		height="72"
		class:list={[sizeClass, 'brand-lockup brand-lockup--light']}
		loading="eager"
		decoding="async"
	/>
	<img
		src="/brand/phasora-logo-dark.png"
		alt="Phasora"
		width="200"
		height="72"
		class:list={[sizeClass, 'brand-lockup brand-lockup--dark']}
		loading="eager"
		decoding="async"
	/>
</span>

<style>
	.brand-lockup-wrap {
		display: inline-block;
		line-height: 0;
	}

	.brand-lockup {
		width: auto;
		object-fit: contain;
	}

	/* Fits inside the original nav bar height (py-3) without stretching the header. */
	.brand-lockup--header {
		height: 2.5rem;
		max-height: 2.5rem;
	}

	/* Footer has more room — use it. */
	.brand-lockup--footer {
		height: 5rem;
	}

	@media (min-width: 640px) {
		.brand-lockup--footer {
			height: 5.5rem;
		}
	}

	@media (min-width: 768px) {
		.brand-lockup--footer {
			height: 6rem;
		}
	}

	html.light .brand-lockup--dark {
		display: none;
	}

	html:not(.light) .brand-lockup--light {
		display: none;
	}
</style>
