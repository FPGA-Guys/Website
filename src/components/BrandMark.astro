---
interface Props {
	size?: 'header' | 'footer';
	class?: string;
}

const { size = 'header', class: className = '' } = Astro.props;
---

{
	size === 'footer' ? (
		<span class:list={['brand-lockup-wrap', className]}>
			<img
				src="/brand/phasora-logo-transparent.png"
				alt="Phasora"
				width="200"
				height="72"
				class="brand-lockup brand-lockup--footer brand-lockup--light"
				loading="eager"
				decoding="async"
			/>
			<img
				src="/brand/phasora-logo-dark.png"
				alt="Phasora"
				width="200"
				height="72"
				class="brand-lockup brand-lockup--footer brand-lockup--dark"
				loading="eager"
				decoding="async"
			/>
		</span>
	) : (
		<span class:list={['brand-wordmark-wrap', className]}>
			<img
				src="/brand/phasora-wordmark-transparent.png"
				alt="Phasora"
				width="240"
				height="32"
				class="brand-wordmark brand-wordmark--light"
				loading="eager"
				decoding="async"
			/>
			<img
				src="/brand/phasora-wordmark-dark.png"
				alt="Phasora"
				width="240"
				height="32"
				class="brand-wordmark brand-wordmark--dark"
				loading="eager"
				decoding="async"
			/>
		</span>
	)
}

<style>
	.brand-wordmark-wrap {
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}

	.brand-lockup-wrap {
		display: inline-block;
		line-height: 0;
	}

	.brand-lockup,
	.brand-wordmark {
		width: auto;
		object-fit: contain;
		display: block;
	}

	/* Header wordmark — slightly below button height for balance */
	.brand-wordmark {
		height: 1.5rem;
		max-height: 1.5rem;
		/* Optical center: letterforms sit slightly high in the crop */
		transform: translateY(1px);
	}

	/* Footer stacked logo */
	.brand-lockup--footer {
		height: 5rem;
	}

	@media (min-width: 640px) {
		.brand-lockup--footer {
			height: 5.5rem;
		}
	}

	@media (min-width: 768px) {
		.brand-lockup--footer {
			height: 6rem;
		}
	}

	html.light .brand-lockup--dark,
	html.light .brand-wordmark--dark {
		display: none;
	}

	html:not(.light) .brand-lockup--light,
	html:not(.light) .brand-wordmark--light {
		display: none;
	}
</style>
