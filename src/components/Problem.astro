---
const stats = [
	{
		value: '$1.4T',
		caption: 'lost every year to unplanned equipment downtime. About 11% of revenue for the world\u2019s 500 largest manufacturers.',
		source: 'Siemens, True Cost of Downtime 2024',
		color: 'text-[#f59e0b]',
	},
	{
		value: '14%',
		caption: 'of manufacturers run any prescriptive maintenance. The other 86% wait for things to break.',
		source: 'Plant Services / Augury, 2024',
		color: 'text-[#60a5fa]',
	},
	{
		value: '30,000+',
		caption: 'mid-market plants in Canada and the US Northeast have no affordable predictive option.',
		source: 'MidMon market analysis, 2025',
		color: 'text-[#5eead4]',
	},
];
---

<section id="problem" class="relative py-24 md:py-32">
	<div class="container-x">
		<div class="mx-auto max-w-3xl text-center">
			<div data-reveal class="flex justify-center">
				<span class="section-eyebrow">The problem</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight text-white md:text-5xl">
				The cost of doing <span class="text-accent">nothing</span>.
			</h2>
			<p data-reveal data-reveal-delay="2" class="mx-auto mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
				Predictive maintenance exists. It just isn\u2019t built for most of the manufacturing world.
			</p>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-3">
			{
				stats.map((stat, i) => (
					<article data-reveal data-reveal-delay={String(i + 1)} class="card p-7">
						<div class={`font-mono text-5xl font-semibold tracking-tight md:text-6xl ${stat.color}`}>
							{stat.value}
						</div>
						<p class="mt-4 text-sm leading-relaxed text-[var(--color-text-muted)]">{stat.caption}</p>
						<p class="mt-5 text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">
							{stat.source}
						</p>
					</article>
				))
			}
		</div>

		<!-- The gap -->
		<div data-reveal class="mt-14">
			<div class="card relative overflow-hidden p-8 md:p-10">
				<div class="grid items-center gap-8 md:grid-cols-[1fr_auto_1fr]">
					<div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
						<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">Enterprise</div>
						<div class="mt-1 text-2xl font-semibold text-white">$1M+ per deployment</div>
						<ul class="mt-4 space-y-2 text-sm text-[var(--color-text-muted)]">
							<li>Augury, Tractian. Fortune 500 only.</li>
							<li>Months of managed onboarding.</li>
							<li>Cloud-dependent, needs data scientists on staff.</li>
						</ul>
					</div>

					<div class="flex flex-col items-center justify-center text-center md:px-2">
						<div class="text-[10px] tracking-[0.3em] text-[var(--color-text-dim)] uppercase">The gap</div>
						<div class="mt-2 font-mono text-4xl font-semibold text-white md:text-5xl">30K+</div>
						<div class="mt-1 max-w-[14rem] text-xs text-[var(--color-text-muted)]">
							mid-market plants with no affordable option
						</div>
					</div>

					<div class="relative rounded-2xl border border-[#2dd4bf]/30 bg-[#2dd4bf]/[0.05] p-6">
						<div class="absolute -top-2 left-6 inline-flex items-center gap-1.5 rounded-full border border-[#2dd4bf]/40 bg-[#04080f] px-2 py-0.5 text-[10px] font-semibold tracking-widest text-[#5eead4] uppercase">
							MidMon
						</div>
						<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">Mid-market</div>
						<div class="mt-1 text-2xl font-semibold text-white">&lt; $10K per line</div>
						<ul class="mt-4 space-y-2 text-sm text-[var(--color-text-muted)]">
							<li>Self-installing. No specialist needed.</li>
							<li>On-device AI. No cloud dependency.</li>
							<li>A plant manager can approve it alone.</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
