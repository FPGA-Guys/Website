---
const team = [
	{
		name: 'Soma Chénard-Koné',
		role: 'CEO',
		focus: 'Strategy and coordination',
		bio: 'Founder. Director of Projects at IEEE Concordia. Started Phasora and assembled the team.',
		photo: '/team/soma.png',
		linkedin: 'https://www.linkedin.com/in/soma-chenardkone/',
		email: 'so_chena@live.concordia.ca',
	},
	{
		name: 'Anabella Kowalski',
		role: 'CTO',
		focus: 'Hardware architecture',
		bio: 'VP Marketing at IEEE Concordia. Past role at Natural Resources Canada. Leads the edge AI hardware design.',
		photo: '/team/anabella.jpeg',
		linkedin: 'https://www.linkedin.com/in/anabella-kowalski-3552k',
		email: 'an_kowal@live.concordia.ca',
	},
	{
		name: 'Nirmal Patel',
		role: 'CPO',
		focus: 'Product and edge ML',
		bio: 'VP of Projects at IEEE Concordia. Owns the anomaly detection models and their deployment to the device.',
		photo: '/team/nirmal.jpeg',
		linkedin: 'https://www.linkedin.com/in/nirmalpatelxyz/',
		email: 'pa_nirm@live.concordia.ca',
	},
	{
		name: 'Eithan Kuri Valdovinos',
		role: 'CFO',
		focus: 'Signal processing',
		bio: 'Industry intern at MDA Space / Airbus Montréal. Handles RF and signal processing.',
		photo: '/team/eithan.jpeg',
		linkedin: 'https://www.linkedin.com/in/eithan-kuri-valdovinos/',
		email: 'e_kuriva@live.concordia.ca',
	},
	{
		name: 'Daniel Akbari',
		role: 'VP Engineering',
		focus: 'Edge inference and infrastructure',
		bio: 'Dual internships in project management and data analysis. Owns infrastructure and customer onboarding.',
		photo: '/team/daniel.jpeg',
		linkedin: 'https://www.linkedin.com/in/daniel-akbari',
		email: 'daniel.akbari@mail.concordia.ca',
	},
	{
		name: 'Sepehr Ghasemzadeh',
		role: 'CBO',
		focus: 'Business development',
		bio: 'Director of Projects at IEEE Concordia since 2024. Owns embedded systems integration and customer outreach.',
		photo: '/team/sepehr.jpeg',
		linkedin: 'https://www.linkedin.com/in/sepehr-ghasemzadeh-moghaddam/',
		email: 'se_gha@live.concordia.ca',
	},
];
---

<section id="team" class="relative pt-8 md:pt-10">
	<div class="container-x">
		<div class="mt-2 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				team.map((member, i) => (
					<article data-reveal data-reveal-delay={String((i % 3) + 1)} class="card p-6">
						<div class="flex items-start gap-4">
							<div class="relative inline-flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl border" style="border-color: var(--color-border);">
								<img
									src={member.photo}
									alt={`Portrait of ${member.name}`}
									width="128"
									height="128"
									loading="lazy"
									decoding="async"
									class="h-full w-full object-cover"
								/>
							</div>
							<div class="min-w-0 flex-1">
								<h3 class="text-base font-semibold" style="color: var(--color-text);">{member.name}</h3>
								<p class="text-xs tracking-wide uppercase text-accent">{member.role}</p>
								<p class="mt-1 text-xs" style="color: var(--color-text-dim);">{member.focus}</p>
							</div>
						</div>
						<p class="mt-5 text-sm leading-relaxed" style="color: var(--color-text-muted);">{member.bio}</p>

						<div class="mt-5 flex items-center gap-2">
							<a
								href={member.linkedin}
								target="_blank"
								rel="noopener"
								aria-label={`${member.name} on LinkedIn`}
								class="inline-flex h-8 w-8 items-center justify-center rounded-full border text-xs transition-colors"
								style="border-color: var(--color-border); background: var(--color-elev-1); color: var(--color-text-muted);"
							>
								<svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
									<path d="M3.07 4.7a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2ZM1.6 5.92h2.94v8.58H1.6V5.92ZM6.34 5.92h2.82v1.17h.04c.39-.74 1.34-1.52 2.76-1.52 2.95 0 3.49 1.94 3.49 4.46v4.47h-2.93v-3.96c0-.94-.02-2.15-1.31-2.15-1.31 0-1.51 1.02-1.51 2.08v4.03H6.34V5.92Z" />
								</svg>
							</a>
							<a
								href={`mailto:${member.email}`}
								aria-label={`Email ${member.name}`}
								class="inline-flex h-8 w-8 items-center justify-center rounded-full border text-xs transition-colors"
								style="border-color: var(--color-border); background: var(--color-elev-1); color: var(--color-text-muted);"
							>
								<svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M2 4l6 5 6-5M2 4v8h12V4M2 4h12" />
								</svg>
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
