---
import { SITE_TITLE, CONTACT_EMAIL } from '../consts';
import BrandMark from './BrandMark.astro';

const today = new Date();

const columns = [
	{
		title: 'Site',
		links: [
			{ label: 'Home', href: '/' },
			{ label: 'Problem', href: '/problem' },
			{ label: 'Product', href: '/product' },
			{ label: 'Blog', href: '/blog' },
			{ label: 'Team', href: '/team' },
			{ label: 'Contact', href: '/contact' },
		],
	},
	{
		title: 'Reach us',
		links: [
			{ label: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` },
			{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/soma-chenardkone/' },
		],
	},
];
---

<footer class="relative mt-16 border-t" style="border-color: var(--color-border); background: var(--color-bg-soft);">
	<div class="container-x py-16">
		<div class="grid gap-10 md:grid-cols-[1.6fr_1fr_1fr]">
			<div data-reveal class="max-w-md">
				<a href="/" class="inline-flex items-center gap-2.5">
					<BrandMark size={28} idSuffix="footer" />
					<span class="text-base font-semibold tracking-tight" style="color: var(--color-text);">{SITE_TITLE}</span>
				</a>
				<p class="mt-5 text-sm leading-relaxed" style="color: var(--color-text-muted);">
					Predictive maintenance for mid-market manufacturers. Self-installing sensors,
					on-device AI, plain-language alerts.
				</p>
				<p class="mt-4 text-xs" style="color: var(--color-text-dim);">
					Built at Concordia University . Gina Cody School of Engineering . Montréal, QC
				</p>
			</div>

			{
				columns.map((col, i) => (
					<div data-reveal data-reveal-delay={String(i + 1)}>
						<h4 class="text-xs font-semibold tracking-widest uppercase" style="color: var(--color-text);">{col.title}</h4>
						<ul class="mt-5 space-y-3 text-sm">
							{col.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="transition-colors hover:underline"
										style="color: var(--color-text-muted);"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="divider-soft mt-12"></div>

		<div
			class="mt-6 flex flex-col items-start justify-between gap-3 text-xs md:flex-row md:items-center"
			style="color: var(--color-text-dim);"
		>
			<p>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
			<div class="flex items-center gap-2">
				<span class="relative flex h-2 w-2">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
				</span>
				<span>Phase 1 in progress</span>
			</div>
		</div>
	</div>
</footer>
