---
const partners = [
	{ name: 'Concordia · Gina Cody Innovation Fund', tag: 'Phase 1 award', context: 'Lab space and a path to Phase 2 commercialization funding.' },
	{ name: 'IEEE Concordia', tag: 'Talent pipeline', context: 'Where four of our six founders have held leadership roles.' },
	{ name: 'CSME Concordia', tag: 'Mechanical depth', context: 'Founder Soma served as VP IT.' },
	{ name: 'Centech', tag: 'Acceleration target', context: 'Top-3 tech accelerator in Canada, MTL.' },
	{ name: 'District 3', tag: 'Acceleration target', context: 'Concordia-based deep-tech incubator.' },
	{ name: 'CRIC', tag: 'Industrial network', context: 'Centre de Recherche Industrielle du Canada.' },
];

const funding = [
	{ label: 'IRAP', detail: 'NRC Industrial Research Assistance Program. Up to $50K for early commercialization.' },
	{ label: 'SR&ED', detail: 'Federal R&D tax credit. Refunds eligible engineering costs from day one.' },
	{ label: 'CRIC + Mitacs', detail: 'Industrial collaboration grants that pair us with established partners.' },
	{ label: 'Prompt', detail: 'Quebec ICT R&D fund covering up to 80% of collaborative project costs.' },
];
---

<section id="backed" class="relative py-24 md:py-32">
	<div class="container-x">
		<div class="mx-auto max-w-3xl text-center">
			<div data-reveal>
				<span class="section-eyebrow">Backed by</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight text-white md:text-5xl">
				A non-dilutive runway by <span class="text-accent">design</span>.
			</h2>
			<p data-reveal data-reveal-delay="2" class="mx-auto mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
				Quebec\u2019s deep-tech funding stack is one of the most founder-friendly in North America. We
				use it.
			</p>
		</div>

		<div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/5 md:grid-cols-3">
			{
				partners.map((p, i) => (
					<article data-reveal data-reveal-delay={String((i % 3) + 1)} class="bg-[var(--color-bg)] p-6">
						<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">
							{p.tag}
						</div>
						<div class="mt-2 text-base font-semibold text-white">{p.name}</div>
						<p class="mt-2 text-xs text-[var(--color-text-muted)]">{p.context}</p>
					</article>
				))
			}
		</div>

		<div data-reveal class="mt-12">
			<div class="card overflow-hidden p-7 md:p-9">
				<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">
					Non-dilutive funding pipeline
				</div>
				<h3 class="mt-2 text-xl font-semibold text-white">
					Up to $250K secured before any equity round
				</h3>
				<div class="mt-6 grid gap-4 md:grid-cols-2">
					{
						funding.map((f) => (
							<div class="rounded-xl border border-white/5 bg-white/[0.02] p-5">
								<div class="text-sm font-semibold text-white">{f.label}</div>
								<p class="mt-1.5 text-xs text-[var(--color-text-muted)]">{f.detail}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
