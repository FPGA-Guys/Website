---
const partners = [
	{ name: 'Concordia University', sub: 'Gina Cody School of Engineering' },
	{ name: 'Gina Cody Innovation Fund', sub: 'Phase 1 seed program' },
	{ name: 'IEEE Concordia', sub: 'Project leadership pipeline' },
	{ name: 'CSME Concordia', sub: 'Mechanical engineering chapter' },
	{ name: 'Centech', sub: 'Industrial network access' },
	{ name: 'AQFP', sub: 'Quebec Food Processing' },
];

const pipeline = [
	{ name: 'NRC IRAP', detail: '$75–200K first-time award (filed)' },
	{ name: 'SR&ED federal credit', detail: '35% refundable on R&D' },
	{ name: 'Quebec CRIC', detail: '30–50% refundable (2025)' },
	{ name: 'Mitacs Accelerate', detail: '$15K / 4-month intern' },
	{ name: 'Prompt Innovation AI', detail: 'Up to $1.5M @ 50% match' },
];
---

<section id="backed" class="relative py-24 md:py-28">
	<div class="container-x">
		<div class="mx-auto max-w-3xl text-center">
			<div data-reveal>
				<span class="section-eyebrow">Backed by &amp; built with</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-2xl font-semibold tracking-tight md:text-4xl">
				A foundation that <span class="text-gradient-accent">de-risks every dollar after the first</span>.
			</h2>
		</div>

		<!-- Partner / affiliation strip -->
		<div data-reveal class="mt-12">
			<div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/5 sm:grid-cols-2 lg:grid-cols-3">
				{
					partners.map((p) => (
						<div class="group flex items-center gap-4 bg-[var(--color-bg)] p-5 transition-colors hover:bg-[var(--color-surface)]">
							<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.02]">
								<svg class="h-5 w-5 text-[var(--color-text-muted)] transition-colors group-hover:text-[#2dd4bf]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M12 2 2 7l10 5 10-5-10-5Z" />
									<path d="M2 17l10 5 10-5M2 12l10 5 10-5" />
								</svg>
							</div>
							<div class="min-w-0">
								<div class="truncate text-sm font-semibold text-white">{p.name}</div>
								<div class="truncate text-[11px] text-[var(--color-text-muted)]">{p.sub}</div>
							</div>
						</div>
					))
				}
			</div>
		</div>

		<!-- Non-dilutive pipeline -->
		<div data-reveal class="mt-10">
			<div class="card overflow-hidden p-7 md:p-8">
				<span class="glow-ring"></span>
				<div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
					<div class="max-w-md">
						<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">Non-dilutive funding pipeline</div>
						<h3 class="mt-2 text-xl font-semibold text-white">
							Federal &amp; provincial credits stack on top of Phase 1.
						</h3>
						<p class="mt-2 text-sm text-[var(--color-text-muted)]">
							A small Innovation Fund seed unlocks a much larger stack of non-dilutive capital
							designed specifically for Canadian hardware startups.
						</p>
					</div>
					<div class="flex flex-wrap gap-2">
						{
							pipeline.map((p) => (
								<div class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1.5">
									<span class="text-xs font-medium text-white">{p.name}</span>
									<span class="ml-2 text-[11px] text-[var(--color-text-muted)]">{p.detail}</span>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
