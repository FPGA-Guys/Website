---
const bullets = [
	'Sensor coverage for vibration, current, and acoustic',
	'Self-installing wireless gateway',
	'Dashboard, email alerts, and CMMS push',
	'Direct support from the engineering team',
];
---

<section id="pricing" class="relative">
	<div class="container-x">
		<div class="mx-auto max-w-3xl text-center">
			<div data-reveal>
				<span class="section-eyebrow">Start small</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight md:text-5xl" style="color: var(--color-text);">
				A <span class="text-accent">pilot</span> on one line.
			</h2>
			<p data-reveal data-reveal-delay="2" class="mx-auto mt-5 max-w-2xl md:text-lg" style="color: var(--color-text-muted);">
				Start with one critical line. Prove it works on your equipment, then expand at your pace.
			</p>
		</div>

		<div data-reveal class="mx-auto mt-12 max-w-lg">
			<article class="card p-8">
				<div class="flex items-baseline justify-between">
					<h3 class="text-2xl font-semibold" style="color: var(--color-text);">Pilot</h3>
					<span class="text-xs" style="color: var(--color-text-dim);">5 to 10 assets</span>
				</div>
				<p class="mt-2 text-sm" style="color: var(--color-text-muted);">
					Single critical production line at one site.
				</p>

				<ul class="mt-8 space-y-3 text-sm">
					{
						bullets.map((b) => (
							<li class="flex items-start gap-2.5" style="color: var(--color-text-muted);">
								<svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 16 16" fill="none">
									<path d="M3 8.5L7 12 13 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								{b}
							</li>
						))
					}
				</ul>

				<a href="/contact" class="btn btn-primary mt-8 w-full">
					Start a pilot
					<svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</a>

				<p class="mt-4 text-center text-xs" style="color: var(--color-text-dim);">
					Pricing is scoped to the line. Get in touch and we will quote on your setup.
				</p>
			</article>
		</div>
	</div>
</section>
