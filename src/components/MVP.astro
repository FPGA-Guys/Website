---
const faults = [
	{ label: 'healthy', tone: 'green', desc: 'baseline envelope' },
	{ label: 'imbalance', tone: 'amber', desc: '1× rotational peak' },
	{ label: 'friction_load', tone: 'amber', desc: 'bearing drag, current up' },
	{ label: 'loose_mount', tone: 'amber', desc: 'chaotic broadband vibration' },
	{ label: 'misalignment', tone: 'amber', desc: '2× harmonic, current ripple' },
	{ label: 'overload', tone: 'red', desc: 'current +50% sustained' },
	{ label: 'rpm_instability', tone: 'red', desc: 'encoder ripple, PWM disturbance' },
	{ label: 'voltage_drop', tone: 'red', desc: 'supply rail dipping' },
];

const toneStyles = {
	green: 'border-emerald-400/30 bg-emerald-400/[0.06] text-emerald-300',
	amber: 'border-amber-400/30 bg-amber-400/[0.06] text-amber-300',
	red: 'border-red-400/30 bg-red-400/[0.06] text-red-300',
};
const toneDots = {
	green: 'bg-emerald-400',
	amber: 'bg-amber-400',
	red: 'bg-red-400',
};
---

<section id="mvp" class="relative py-24 md:py-32">
	<div class="container-x">
		<div class="mx-auto flex max-w-3xl flex-col items-center text-center">
			<div data-reveal class="flex items-center gap-2">
				<span class="section-eyebrow">
					<span class="h-1.5 w-1.5 rounded-full bg-[#2dd4bf]"></span>
					Phase 1 in progress
				</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight text-white md:text-5xl">
				What\u2019s running on the <span class="text-accent">bench, today</span>.
			</h2>
			<p data-reveal data-reveal-delay="2" class="mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
				A working benchtop diagnostic station. Real sensors, real edge inference, eight controllable
				fault classes injected on the rig. The proof, not the slide.
			</p>
		</div>

		<!-- Architecture row -->
		<div data-reveal class="mt-12">
			<div class="card relative overflow-hidden p-6 md:p-8">
				<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">
					System architecture
				</div>

				<div class="mt-5 grid items-stretch gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr]">
					<div class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
						<div class="text-xs font-semibold tracking-wide text-white uppercase">Test rig</div>
						<div class="mt-3 text-sm text-white">12 V DC encoder motors with sensors</div>
						<div class="mt-1 text-xs text-[var(--color-text-muted)]">
							Two physically identical units: one healthy reference, one for fault injection.
						</div>
						<div class="mt-4 space-y-1.5 border-t border-white/5 pt-3 text-[11px] text-[var(--color-text-muted)]">
							<div>3-axis accelerometer (SPI, 4 kHz)</div>
							<div>Hall-effect current sensor</div>
							<div>Voltage and temperature monitoring</div>
							<div>Quadrature encoder for RPM</div>
						</div>
					</div>

					<div class="hidden items-center justify-center lg:flex">
						<svg class="h-6 w-6 text-[var(--color-text-dim)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</div>

					<div class="rounded-2xl border border-[#2dd4bf]/30 bg-[#2dd4bf]/[0.05] p-5">
						<div class="text-xs font-semibold tracking-wide text-white uppercase">Acquisition</div>
						<div class="mt-3 text-sm text-white">FPGA front-end</div>
						<div class="mt-1 text-xs text-[var(--color-text-muted)]">
							Deterministic sampling, encoder counting, timestamping, packetized telemetry.
						</div>
						<div class="mt-4 flex flex-wrap gap-1.5 border-t border-white/5 pt-3">
							<span class="chip font-mono text-[10px]">Deterministic capture</span>
							<span class="chip font-mono text-[10px]">RMS / FFT preproc</span>
							<span class="chip font-mono text-[10px]">UART link</span>
						</div>
					</div>

					<div class="hidden items-center justify-center lg:flex">
						<svg class="h-6 w-6 text-[var(--color-text-dim)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</div>

					<div class="rounded-2xl border border-[#60a5fa]/30 bg-[#60a5fa]/[0.05] p-5">
						<div class="text-xs font-semibold tracking-wide text-white uppercase">Edge inference</div>
						<div class="mt-3 text-sm text-white">On-device dashboard</div>
						<div class="mt-1 text-xs text-[var(--color-text-muted)]">
							1-D CNN classifier with FFT features. Logs, alerts, and a live dashboard render
							straight to the rig.
						</div>
						<div class="mt-4 flex flex-wrap gap-1.5 border-t border-white/5 pt-3">
							<span class="chip font-mono text-[10px]">1-D CNN + FFT</span>
							<span class="chip font-mono text-[10px]">No cloud</span>
							<span class="chip font-mono text-[10px]">Local dashboard</span>
						</div>
					</div>
				</div>

				<div class="mt-6 rounded-xl border border-white/5 bg-white/[0.02] px-4 py-3 text-xs text-[var(--color-text-muted)]">
					Phase 1 MVP runs on commodity dev hardware to prove the architecture and the model.
					Production silicon and form factor follow.
				</div>
			</div>
		</div>

		<!-- 8 fault classes -->
		<div class="mt-10 grid gap-6 lg:grid-cols-[1.1fr_2fr]">
			<div data-reveal>
				<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">
					Classifier output
				</div>
				<h3 class="mt-2 text-2xl font-semibold text-white">
					Eight controllable fault classes
				</h3>
				<p class="mt-3 text-sm text-[var(--color-text-muted)]">
					Each class has a defined physical fault-injection procedure on the rig, from a known
					mass on the rotating disk to a calibrated PWM disturbance. Repeatable, labeled
					ground-truth from day one.
				</p>
			</div>

			<div data-reveal data-reveal-delay="1">
				<div class="grid grid-cols-2 gap-2.5 md:grid-cols-3">
					{
						faults.map((f) => (
							<div class={`flex items-center gap-2 rounded-xl border px-3 py-2.5 ${toneStyles[f.tone]}`}>
								<span class={`h-1.5 w-1.5 shrink-0 rounded-full ${toneDots[f.tone]}`} />
								<div class="min-w-0">
									<div class="font-mono text-xs font-semibold">{f.label}</div>
									<div class="truncate text-[10px] text-white/60">{f.desc}</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
