---
const faults = [
	{ label: 'healthy', tone: 'green', desc: 'Baseline operating envelope' },
	{ label: 'imbalance', tone: 'amber', desc: 'Shaft mass eccentricity, 1× peak' },
	{ label: 'friction_load', tone: 'amber', desc: 'Bearing drag, elevated current' },
	{ label: 'loose_mount', tone: 'amber', desc: 'Chaotic broadband vibration' },
	{ label: 'misalignment', tone: 'amber', desc: 'Coupler offset, 2× harmonic' },
	{ label: 'overload', tone: 'red', desc: 'Current threshold +50% sustained' },
	{ label: 'rpm_instability', tone: 'red', desc: 'PWM disturbance, encoder ripple' },
	{ label: 'voltage_drop', tone: 'red', desc: 'Electrical stress / brownout' },
];

const sensors = [
	{ part: 'ADXL355', role: '3-axis vibration · SPI · 4 kHz' },
	{ part: 'ACS712', role: 'Hall-effect motor current · analog' },
	{ part: 'MCP3208 ADC', role: 'Voltage divider + current acquisition' },
	{ part: 'Hall encoder', role: 'RPM & instability detection' },
	{ part: 'NTC + case probe', role: 'Motor casing temperature' },
];

const toneStyles = {
	green: 'border-emerald-400/30 bg-emerald-400/[0.06] text-emerald-300',
	amber: 'border-amber-400/30 bg-amber-400/[0.06] text-amber-300',
	red: 'border-red-400/30 bg-red-400/[0.06] text-red-300',
};
const toneDots = {
	green: 'bg-emerald-400',
	amber: 'bg-amber-400',
	red: 'bg-red-400',
};
---

<section id="mvp" class="relative py-28 md:py-36">
	<div class="container-x">
		<div class="mx-auto flex max-w-3xl flex-col items-center text-center">
			<div data-reveal class="flex items-center gap-2">
				<span class="section-eyebrow">
					<span class="relative flex h-1.5 w-1.5">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#2dd4bf] opacity-70"></span>
						<span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#2dd4bf]"></span>
					</span>
					Phase 1 · in progress
				</span>
			</div>
			<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight md:text-5xl">
				What's running on the <span class="text-gradient-accent">bench, today</span>.
			</h2>
			<p data-reveal data-reveal-delay="2" class="mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
				The Phase 1 MVP is a benchtop DC-motor diagnostic station: real sensors, a real FPGA, a
				real edge inference target, and eight controllable fault classes injected on the rig.
				It's the proof, not the slide.
			</p>
		</div>

		<!-- Architecture diagram -->
		<div data-reveal class="mt-14">
			<div class="card relative overflow-hidden p-6 md:p-8">
				<span class="glow-ring"></span>

				<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">
					System architecture &mdash; benchtop rig
				</div>

				<div class="mt-5 grid items-stretch gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr]">
					<!-- Stage 1: motors + sensors -->
					<div class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
						<div class="flex items-center gap-2">
							<svg class="h-4 w-4 text-[#2dd4bf]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="12" cy="12" r="4" />
								<circle cx="12" cy="12" r="9" opacity="0.4" />
								<path d="M12 3v2M12 19v2M3 12h2M19 12h2" />
							</svg>
							<span class="text-xs font-semibold tracking-wide text-white uppercase">Test rig</span>
						</div>
						<div class="mt-3 space-y-1.5">
							<div class="text-sm text-white">2× 12 V DC encoder gear motors</div>
							<div class="text-xs text-[var(--color-text-muted)]">
								Motor A: healthy reference &middot; Motor B: fault injection
							</div>
						</div>
						<div class="mt-4 space-y-2 border-t border-white/5 pt-3">
							{
								sensors.map((s) => (
									<div class="flex items-baseline justify-between gap-2 text-[11px]">
										<span class="font-mono text-white/90">{s.part}</span>
										<span class="text-right text-[var(--color-text-dim)]">{s.role}</span>
									</div>
								))
							}
						</div>
					</div>

					<!-- arrow -->
					<div class="hidden items-center justify-center lg:flex">
						<svg class="h-6 w-6 text-[var(--color-text-dim)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</div>

					<!-- Stage 2: FPGA -->
					<div class="rounded-2xl border border-[#2dd4bf]/30 bg-gradient-to-br from-[#2dd4bf]/[0.08] to-transparent p-5">
						<div class="flex items-center gap-2">
							<svg class="h-4 w-4 text-[#2dd4bf]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="6" y="6" width="12" height="12" rx="2" />
								<path d="M9 9h6v6H9z" />
								<path d="M3 9h3M3 12h3M3 15h3M18 9h3M18 12h3M18 15h3M9 3v3M12 3v3M15 3v3M9 18v3M12 18v3M15 18v3" />
							</svg>
							<span class="text-xs font-semibold tracking-wide text-white uppercase">FPGA acquisition</span>
						</div>
						<div class="mt-3 space-y-1.5">
							<div class="font-mono text-sm text-white">Sipeed Tang Nano 20K</div>
							<div class="text-xs text-[var(--color-text-muted)]">
								Deterministic sampling, encoder/RPM counting, ADC control, timestamping,
								structured UART packets.
							</div>
						</div>
						<div class="mt-4 flex flex-wrap gap-1.5 border-t border-white/5 pt-3">
							{
								['SPI · I²S · GPIO', '4 kHz vibration', '1 kHz current', '20 Hz RPM', 'UART link'].map((c) => (
									<span class="chip font-mono text-[10px]">{c}</span>
								))
							}
						</div>
					</div>

					<!-- arrow -->
					<div class="hidden items-center justify-center lg:flex">
						<svg class="h-6 w-6 text-[var(--color-text-dim)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</div>

					<!-- Stage 3: Jetson -->
					<div class="rounded-2xl border border-[#60a5fa]/30 bg-gradient-to-br from-[#60a5fa]/[0.08] to-transparent p-5">
						<div class="flex items-center gap-2">
							<svg class="h-4 w-4 text-[#60a5fa]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M9.5 3a3 3 0 0 0-3 3v.5A3 3 0 0 0 4 9.5v1A3 3 0 0 0 6 14a3 3 0 0 0 3 3 3 3 0 0 0 3-3V3.5A.5.5 0 0 0 11.5 3H9.5Z" />
								<path d="M14.5 3a3 3 0 0 1 3 3v.5A3 3 0 0 1 20 9.5v1A3 3 0 0 1 18 14a3 3 0 0 1-3 3 3 3 0 0 1-3-3V3.5a.5.5 0 0 1 .5-.5h2Z" />
							</svg>
							<span class="text-xs font-semibold tracking-wide text-white uppercase">Edge inference</span>
						</div>
						<div class="mt-3 space-y-1.5">
							<div class="font-mono text-sm text-white">Jetson Orin Nano Super</div>
							<div class="text-xs text-[var(--color-text-muted)]">
								Packet decoding, FFT features, 1D-CNN inference, alert logic, dashboard
								render straight to HDMI.
							</div>
						</div>
						<div class="mt-4 flex flex-wrap gap-1.5 border-t border-white/5 pt-3">
							{
								['1D-CNN + FFT', 'No cloud', 'HDMI dashboard', 'On-device logs', 'OTA models'].map((c) => (
									<span class="chip font-mono text-[10px]">{c}</span>
								))
							}
						</div>
					</div>
				</div>

				<!-- Honest note about MVP vs production target -->
				<div class="mt-6 flex flex-col items-start gap-3 rounded-xl border border-white/5 bg-white/[0.02] p-4 text-xs text-[var(--color-text-muted)] md:flex-row md:items-center md:justify-between">
					<div>
						<span class="font-semibold text-white">Phase 1 MVP</span> &middot; commodity hardware to
						prove the architecture and the model. Production v1 ships on the AMD Versal AI Edge
						target outlined below.
					</div>
					<a href="#tech" class="inline-flex items-center gap-1 text-[var(--color-accent)] hover:text-white">
						See production stack
						<svg class="h-3 w-3" viewBox="0 0 16 16" fill="none" aria-hidden="true">
							<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				</div>
			</div>
		</div>

		<!-- 8 fault classes -->
		<div class="mt-10 grid gap-6 lg:grid-cols-[1.1fr_2fr]">
			<div data-reveal>
				<div class="text-[10px] tracking-widest text-[var(--color-text-dim)] uppercase">
					Classifier output
				</div>
				<h3 class="mt-2 text-2xl font-semibold text-white">
					Eight controllable fault classes
				</h3>
				<p class="mt-3 text-sm text-[var(--color-text-muted)]">
					Each class has a defined physical fault-injection procedure on the rig &mdash; from a
					known mass on the rotating disk to a calibrated PWM disturbance. Repeatable, labeled,
					ground-truth datasets from day one.
				</p>
			</div>

			<div data-reveal data-reveal-delay="1">
				<div class="grid grid-cols-2 gap-2.5 md:grid-cols-3">
					{
						faults.map((f) => (
							<div class={`flex items-center gap-2 rounded-xl border px-3 py-2.5 ${toneStyles[f.tone]}`}>
								<span class={`h-1.5 w-1.5 shrink-0 rounded-full ${toneDots[f.tone]}`} />
								<div class="min-w-0">
									<div class="font-mono text-xs font-semibold">{f.label}</div>
									<div class="truncate text-[10px] text-white/60">{f.desc}</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
