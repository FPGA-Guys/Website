---
import { CONTACT_EMAIL } from '../consts';

const audiences = [
	{
		label: 'Plant manager',
		body: "Curious if a pilot fits your line? Fifteen minutes, we walk through install and what changes for your team.",
	},
	{
		label: 'Maintenance engineer',
		body: 'Want to see the data, the alert flow, and how it maps to your CMMS? Happy to demo on real recorded faults.',
	},
	{
		label: 'Reliability lead',
		body: "Building out a condition-monitoring program? We can talk about coverage, baselines, and false-positive handling.",
	},
];
---

<section id="contact" class="relative pt-8 pb-12 md:pt-10 md:pb-14">
	<div class="container-x">
		<div class="card relative overflow-hidden p-8 md:p-14">
			<div class="grid items-start gap-10 lg:grid-cols-[1.2fr_1fr]">
				<div>
					<div data-reveal>
						<span class="section-eyebrow">Get in touch</span>
					</div>
					<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight md:text-5xl" style="color: var(--color-text);">
						Talk to the <span class="text-accent">team</span>.
					</h2>
					<p data-reveal data-reveal-delay="2" class="mt-5 max-w-xl md:text-lg" style="color: var(--color-text-muted);">
						Everything goes straight to our founder. Reply within one business day.
					</p>

					<div data-reveal data-reveal-delay="3" class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
						<a href={`mailto:${CONTACT_EMAIL}?subject=Phasora%20intro`} class="btn btn-primary">
							Email {CONTACT_EMAIL}
							<svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
							</svg>
						</a>
						<a href="https://www.linkedin.com/in/soma-chenardkone/" target="_blank" rel="noopener" class="btn btn-ghost">
							<svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
								<path d="M3.07 4.7a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2ZM1.6 5.92h2.94v8.58H1.6V5.92ZM6.34 5.92h2.82v1.17h.04c.39-.74 1.34-1.52 2.76-1.52 2.95 0 3.49 1.94 3.49 4.46v4.47h-2.93v-3.96c0-.94-.02-2.15-1.31-2.15-1.31 0-1.51 1.02-1.51 2.08v4.03H6.34V5.92Z" />
							</svg>
							Connect on LinkedIn
						</a>
					</div>

					<p data-reveal data-reveal-delay="4" class="mt-6 text-xs" style="color: var(--color-text-dim);">
						Concordia University . Gina Cody School of Engineering . Montréal, QC
					</p>
				</div>

				<div data-reveal class="space-y-3">
					{
						audiences.map((a) => (
							<div class="rounded-2xl border p-5 transition-colors" style="border-color: var(--color-border); background: var(--color-elev-1);">
								<div class="flex items-center gap-2">
									<span class="inline-flex h-2 w-2 rounded-full" style="background: var(--color-accent);" />
									<div class="text-xs font-medium tracking-widest uppercase text-accent">
										{a.label}
									</div>
								</div>
								<p class="mt-2 text-sm" style="color: var(--color-text-muted);">{a.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
