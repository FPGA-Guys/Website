---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<section id="updates" class="relative py-28 md:py-36">
	<div class="container-x">
		<div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
			<div class="max-w-2xl">
				<div data-reveal>
					<span class="section-eyebrow">Updates</span>
				</div>
				<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight md:text-5xl">
					Field notes from <span class="text-gradient-accent">the build</span>.
				</h2>
				<p data-reveal data-reveal-delay="2" class="mt-5 text-[var(--color-text-muted)] md:text-lg">
					Engineering deep-dives, post-mortems, and the occasional opinion on where industrial AI
					is heading. Written by the team, not a content agency.
				</p>
			</div>
			<a data-reveal data-reveal-delay="3" href="/blog" class="btn btn-ghost">
				All updates
				<svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</a>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-3">
			{
				posts.map((post, i) => {
					const tints = [
						'rgba(45,212,191,0.40)',
						'rgba(96,165,250,0.38)',
						'rgba(52,211,153,0.36)',
					];
					return (
						<a
							data-reveal
							data-reveal-delay={String((i % 3) + 1)}
							href={`/blog/${post.id}/`}
							class="card group block overflow-hidden p-0"
						>
							<span class="glow-ring" />
							<div class="relative h-44 overflow-hidden">
								<div class="absolute inset-0 bg-gradient-to-br from-[#0f2138] via-[#0a172a] to-[#04080f]" />
								<div class="absolute inset-0 bg-grid opacity-40" />
								<div
									class="absolute inset-0 opacity-80"
									style={`background: radial-gradient(circle at ${20 + i * 30}% ${30 + i * 20}%, ${tints[i % 3]}, transparent 60%);`}
								/>

								<!-- decorative SVG glyph per post -->
								<svg class="absolute inset-0 m-auto h-24 w-24 text-white/15" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2">
									{i === 0 && <rect x="10" y="10" width="44" height="44" rx="8" />}
									{i === 0 && <path d="M22 32h20M22 22h20M22 42h12" />}
									{i === 1 && <rect x="14" y="14" width="36" height="36" rx="6" />}
									{i === 1 && <path d="M22 22h20v20H22zM4 32h10M50 32h10M32 4v10M32 50v10" />}
									{i === 2 && <path d="M8 48l12-20 8 12 12-24 16 32" />}
									{i === 2 && <circle cx="56" cy="48" r="2" fill="currentColor" />}
								</svg>

								<div class="absolute bottom-4 left-5 right-5 flex items-center justify-between">
									<span class="chip bg-black/40 backdrop-blur">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="font-mono text-[10px] tracking-widest text-white/60 uppercase">
										note {String(i + 1).padStart(2, '0')}
									</span>
								</div>
							</div>
							<div class="p-6">
								<h3 class="text-lg font-semibold leading-snug text-white transition-colors group-hover:text-[#a7f3d0]">
									{post.data.title}
								</h3>
								<p class="mt-3 line-clamp-2 text-sm text-[var(--color-text-muted)]">
									{post.data.description}
								</p>
								<div class="mt-5 inline-flex items-center gap-1.5 text-sm text-[var(--color-text-muted)] transition-colors group-hover:text-white">
									Read note
									<svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
										<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</div>
							</div>
						</a>
					);
				})
			}
		</div>
	</div>
</section>
