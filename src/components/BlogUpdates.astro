---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const fallback = [
	{
		id: 'sample-1',
		data: {
			title: 'How we compile PyTorch graphs to bitstreams in under a minute',
			description:
				'The compiler pipeline behind Forge.dev — from graph capture to placed-and-routed FPGA design.',
			pubDate: new Date('2026-05-12'),
		},
	},
	{
		id: 'sample-2',
		data: {
			title: 'Sparse attention on silicon: a Helix-1 case study',
			description: 'What changes when you can rewrite the dataflow for every layer.',
			pubDate: new Date('2026-04-21'),
		},
	},
	{
		id: 'sample-3',
		data: {
			title: 'Why we chose UltraScale+ for our first generation',
			description:
				'A look at the trade-offs between off-the-shelf FPGAs and our long-term ASIC roadmap.',
			pubDate: new Date('2026-03-30'),
		},
	},
];

const display = posts.length > 0 ? posts : fallback;
---

<section id="blog" class="relative py-28 md:py-36">
	<div class="container-x">
		<div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
			<div class="max-w-2xl">
				<div data-reveal>
					<span class="section-eyebrow">Blog updates</span>
				</div>
				<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight md:text-5xl">
					Field notes from the <span class="text-gradient-accent">silicon edge</span>.
				</h2>
				<p data-reveal data-reveal-delay="2" class="mt-5 text-[var(--color-text-muted)] md:text-lg">
					Engineering deep-dives, post-mortems, and the occasional opinion on where AI hardware
					is heading.
				</p>
			</div>
			<a data-reveal data-reveal-delay="3" href="/blog" class="btn btn-ghost">
				All posts
				<svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</a>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-3">
			{
				display.map((post, i) => (
					<a
						data-reveal
						data-reveal-delay={String((i % 3) + 1)}
						href={posts.length > 0 ? `/blog/${post.id}/` : '#'}
						class="card group block overflow-hidden p-0"
					>
						<span class="glow-ring" />
						<div class="relative h-44 overflow-hidden">
							<div class="absolute inset-0 bg-gradient-to-br from-[#1a1f3a] via-[#0e1220] to-[#0a0d16]" />
							<div class="absolute inset-0 bg-grid opacity-40" />
							<div
								class="absolute inset-0 opacity-70"
								style={`background: radial-gradient(circle at ${20 + i * 30}% ${30 + i * 20}%, ${i === 0 ? 'rgba(124,92,255,0.45)' : i === 1 ? 'rgba(34,211,238,0.4)' : 'rgba(244,114,182,0.35)'}, transparent 60%);`}
							/>
							<div class="absolute bottom-4 left-5 right-5 flex items-center justify-between">
								<span class="chip bg-black/40 backdrop-blur">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="font-mono text-[10px] tracking-widest text-white/60 uppercase">
									post {String(i + 1).padStart(2, '0')}
								</span>
							</div>
						</div>
						<div class="p-6">
							<h3 class="text-lg font-semibold leading-snug text-white transition-colors group-hover:text-[#c7c1ff]">
								{post.data.title}
							</h3>
							<p class="mt-3 line-clamp-2 text-sm text-[var(--color-text-muted)]">
								{post.data.description}
							</p>
							<div class="mt-5 inline-flex items-center gap-1.5 text-sm text-[var(--color-text-muted)] transition-colors group-hover:text-white">
								Read article
								<svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
									<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
