---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Team from '../components/Team.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Team . ${SITE_TITLE}`}
	description="The six engineers building Phasora."
>
	<Header />
		<main class="page-main">
			<section class="container-x">
				<div class="mx-auto max-w-3xl text-center">
					<div data-reveal>
						<span class="section-eyebrow">The team</span>
					</div>
					<h1 data-reveal data-reveal-delay="1" class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl" style="color: var(--color-text);">
						Six engineers. <span class="text-accent">Each one a discipline.</span>
					</h1>
					<p data-reveal data-reveal-delay="2" class="mx-auto mt-6 max-w-2xl text-lg" style="color: var(--color-text-muted);">
						Hardware, signal processing, edge ML, embedded systems, integration, and customer
						development. One owner per area, no gaps.
					</p>
				</div>
			</section>

			<Team />
		</main>
	<Footer />
</BaseLayout>
