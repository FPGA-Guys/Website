---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { fetchSanity, sanityConfigured } from '../../lib/sanity-client';
import { imageUrl } from '../../lib/sanity-image';
import { postsQuery } from '../../sanity/queries';
import { SITE_TITLE } from '../../consts';
import type {
	PostBySlugQueryResult,
	PostsQueryResult,
	PostSlugsQueryResult,
} from '../../types/sanity.types';

const posts = sanityConfigured
	? await fetchSanity<PostsQueryResult>(postsQuery)
	: [];
---

<BaseLayout
	title={`Blog | ${SITE_TITLE}`}
	description="Updates and field notes from the Phasora team."
>
	<Header />
		<main class="page-main page-main--blog">
			<section class="container-x">
				<div class="mx-auto max-w-3xl text-center">
					<div data-reveal>
						<span class="section-eyebrow">Blog</span>
					</div>
					<h1 data-reveal data-reveal-delay="1" class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl" style="color: var(--color-text);">
						<span class="text-accent">Field notes</span> from the build.
					</h1>
					<p data-reveal data-reveal-delay="2" class="mx-auto mt-5 max-w-2xl md:text-lg" style="color: var(--color-text-muted);">
						Product updates, engineering notes, and what we are learning on the floor.
					</p>
				</div>

				{
					!sanityConfigured ? (
						<div data-reveal class="mx-auto mt-16 max-w-xl rounded-2xl border p-8 text-center" style="border-color: var(--color-border); background: var(--color-elev-1);">
							<p class="text-sm" style="color: var(--color-text-muted);">
								Blog is not connected yet. Copy <code class="font-mono text-xs">.env.example</code> to
								<code class="font-mono text-xs">.env</code>, add your Sanity project ID, then rebuild.
							</p>
						</div>
					) : posts.length === 0 ? (
						<div data-reveal class="mx-auto mt-16 max-w-xl rounded-2xl border p-8 text-center" style="border-color: var(--color-border); background: var(--color-elev-1);">
							<p class="text-sm" style="color: var(--color-text-muted);">
								We are working on our first article. Check back soon for updates.
							</p>
						</div>
					) : (
						<ul class="mx-auto mt-16 grid max-w-6xl grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
							{
								posts.map((post, i) => {
									const coverSrc = imageUrl(post.coverImage, { width: 720, height: 360, quality: 80 });
									return (
										<li>
											<a href={`/blog/${post.slug}/`} class="card group block overflow-hidden p-0">
												<div class="relative h-48 overflow-hidden border-b" style="border-color: var(--color-border); background: var(--color-bg-soft);">
													{
														coverSrc ? (
															<img
																src={coverSrc}
																alt=""
																class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-500 group-hover:scale-[1.03]"
																loading="lazy"
															/>
														) : (
															<div class="absolute inset-0" style="background: var(--color-elev-1);" />
														)
													}
													<div class="absolute right-5 bottom-4 left-5 flex items-center justify-between">
														<span class="chip bg-black/40 backdrop-blur">
															<FormattedDate date={post.publishedDate} />
														</span>
														{post.category?.title && (
															<span class="font-mono text-[10px] tracking-widest uppercase text-white/70">
																{post.category.title}
															</span>
														)}
													</div>
												</div>
												<div class="p-6">
													<h2 class="text-lg leading-snug font-semibold transition-colors group-hover:text-accent" style="color: var(--color-text);">
														{post.title}
													</h2>
													{
														post.excerpt && (
															<p class="mt-3 line-clamp-2 text-sm" style="color: var(--color-text-muted);">
																{post.excerpt}
															</p>
														)
													}
													{
														post.author?.name && (
															<p class="mt-4 text-xs" style="color: var(--color-text-dim);">
																{post.author.name}
															</p>
														)
													}
												</div>
											</a>
										</li>
									);
								})
							}
						</ul>
					)
				}
			</section>
		</main>
	<Footer />
</BaseLayout>
