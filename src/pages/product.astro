---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TechStack from '../components/TechStack.astro';
import Pricing from '../components/Pricing.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Product | ${SITE_TITLE}`}
	description="How Phasora works. Self-installing sensors, on-device AI, plain-language alerts."
>
	<Header />
		<main class="page-main">
			<section class="container-x">
				<div class="mx-auto max-w-3xl text-center">
					<div data-reveal>
						<span class="section-eyebrow">The product</span>
					</div>
					<h1 data-reveal data-reveal-delay="1" class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl" style="color: var(--color-text);">
						Continuous monitoring,
						<br class="hidden sm:block" />
						<span class="text-accent">end to end</span>.
					</h1>
					<p data-reveal data-reveal-delay="2" class="mx-auto mt-6 max-w-2xl text-lg" style="color: var(--color-text-muted);">
						A single small device per asset, a single small gateway per facility, and alerts
						in the systems your team already uses.
					</p>
				</div>
			</section>

			<HowItWorks />
			<TechStack />
			<Pricing />
		</main>
	<Footer />
</BaseLayout>
