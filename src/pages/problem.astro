---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pains = [
	{
		title: 'Unexpected downtime',
		body: "A single bearing seizure can shut down a line for hours. You usually find out about it when production has already stopped.",
	},
	{
		title: 'Over-maintenance',
		body: 'Time-based replacement schedules swap out parts that still had life. You spend on rebuilds you did not need to do yet.',
	},
	{
		title: 'Manual walk-arounds',
		body: 'A vibration meter in a technician\'s hand catches what they happen to be near. The other twenty-three hours of the day, you are flying blind.',
	},
	{
		title: 'Reactive culture',
		body: 'When the team is always chasing the last breakdown, there is no slack left to do real reliability work.',
	},
];

const benefits = [
	{
		title: 'See it coming',
		body: 'Vibration, current, and temperature monitored continuously. Drift from healthy baseline triggers an alert hours or days before failure.',
	},
	{
		title: 'Maintain on condition',
		body: 'Replace bearings when they need replacing, not when the calendar says so. Stop pulling healthy parts.',
	},
	{
		title: 'A simple alert, in plain language',
		body: 'Fault type, severity, recommended action. Routed straight to the system your maintenance team already uses.',
	},
];
---

<BaseLayout
	title={`Problem . ${SITE_TITLE}`}
	description="Why most mid-market plants still run reactive maintenance, and what changes when machines can warn you."
>
	<Header />
		<main class="pt-36 pb-24 md:pt-44">
			<section class="container-x">
				<div class="mx-auto max-w-3xl text-center">
					<div data-reveal>
						<span class="section-eyebrow">The problem</span>
					</div>
					<h1 data-reveal data-reveal-delay="1" class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl" style="color: var(--color-text);">
						Your machines are talking.
						<br class="hidden sm:block" />
						<span class="text-accent">Nobody is listening.</span>
					</h1>
					<p data-reveal data-reveal-delay="2" class="mx-auto mt-6 max-w-2xl text-lg" style="color: var(--color-text-muted);">
						Most plants run maintenance the same way they did in the 1990s. Fix it after it
						breaks, replace parts on a schedule, hope nothing critical fails on a Friday.
					</p>
				</div>

				<div class="mx-auto mt-16 grid max-w-5xl gap-5 md:grid-cols-2">
					{
						pains.map((p, i) => (
							<article data-reveal data-reveal-delay={String((i % 4) + 1)} class="card p-7">
								<h2 class="text-lg font-semibold" style="color: var(--color-text);">{p.title}</h2>
								<p class="mt-3 text-sm leading-relaxed" style="color: var(--color-text-muted);">
									{p.body}
								</p>
							</article>
						))
					}
				</div>

				<div class="mx-auto mt-20 max-w-4xl text-center">
					<div data-reveal>
						<span class="section-eyebrow">What changes</span>
					</div>
					<h2 data-reveal data-reveal-delay="1" class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl" style="color: var(--color-text);">
						Continuous monitoring, on every critical asset.
					</h2>
					<p data-reveal data-reveal-delay="2" class="mx-auto mt-5 max-w-2xl" style="color: var(--color-text-muted);">
						Permanent sensors. Always on. Always learning what healthy looks like for
						<em>your</em> equipment.
					</p>
				</div>

				<div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-3">
					{
						benefits.map((b, i) => (
							<article data-reveal data-reveal-delay={String((i % 3) + 1)} class="card p-6">
								<div class="inline-flex h-9 w-9 items-center justify-center rounded-xl border" style="border-color: var(--color-border); background: var(--color-elev-1);">
									<svg class="h-4 w-4 text-accent" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
										<path d="M3 8.5L7 12 13 4" />
									</svg>
								</div>
								<h3 class="mt-4 text-base font-semibold" style="color: var(--color-text);">{b.title}</h3>
								<p class="mt-2 text-sm leading-relaxed" style="color: var(--color-text-muted);">{b.body}</p>
							</article>
						))
					}
				</div>

				<div data-reveal class="mx-auto mt-20 max-w-3xl text-center">
					<a href="/product" class="btn btn-primary">
						See how it works
						<svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
							<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</a>
				</div>
			</section>
		</main>
	<Footer />
</BaseLayout>
