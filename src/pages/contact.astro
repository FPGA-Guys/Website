---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Contact . ${SITE_TITLE}`}
	description="Talk to the MidMon team."
>
	<Header />
		<main class="pt-36 pb-24 md:pt-44">
			<section class="container-x">
				<div class="mx-auto max-w-3xl text-center">
					<div data-reveal>
						<span class="section-eyebrow">Contact</span>
					</div>
					<h1 data-reveal data-reveal-delay="1" class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl" style="color: var(--color-text);">
						Want to <span class="text-accent">see it on your line</span>?
					</h1>
					<p data-reveal data-reveal-delay="2" class="mx-auto mt-6 max-w-2xl text-lg" style="color: var(--color-text-muted);">
						The fastest way to get answers is a short call. Tell us a bit about the equipment
						and we will walk through what a pilot would look like on your floor.
					</p>
				</div>
			</section>

			<Contact />
		</main>
	<Footer />
</BaseLayout>
