---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="pt-36 md:pt-44 pb-24">
			<article class="container-x">
				<div class="mx-auto max-w-3xl">
					<p class="text-xs tracking-widest text-[var(--color-text-dim)] uppercase">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="ml-2 italic">
									(updated <FormattedDate date={updatedDate} />)
								</span>
							)
						}
					</p>
					<h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">{title}</h1>
					{description && <p class="mt-4 text-lg text-[var(--color-text-muted)]">{description}</p>}
				</div>

				{
					heroImage && (
						<div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-2xl border border-white/10">
							<Image width={1200} height={600} src={heroImage} alt="" class="h-auto w-full" />
						</div>
					)
				}

				<div class="prose mx-auto mt-10 max-w-3xl">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<style is:global>
			.prose {
				color: var(--color-text);
				font-size: 1.05rem;
				line-height: 1.75;
			}
			.prose p {
				margin: 0 0 1.25em 0;
				color: rgba(230, 232, 239, 0.9);
			}
			.prose h2 {
				margin: 2em 0 0.6em;
				font-size: 1.75rem;
				color: #fff;
			}
			.prose h3 {
				margin: 1.8em 0 0.5em;
				font-size: 1.35rem;
				color: #fff;
			}
			.prose a {
				color: #c7c1ff;
				text-decoration: underline;
				text-decoration-color: rgba(124, 92, 255, 0.5);
				text-underline-offset: 3px;
			}
			.prose a:hover {
				color: #fff;
				text-decoration-color: #22d3ee;
			}
			.prose ul,
			.prose ol {
				margin: 0 0 1.25em 1.5em;
			}
			.prose li {
				margin: 0.3em 0;
			}
			.prose blockquote {
				margin: 1.5em 0;
				padding: 0.4em 1.25em;
				border-left: 3px solid #7c5cff;
				background: rgba(124, 92, 255, 0.05);
				color: var(--color-text-muted);
				border-radius: 0 8px 8px 0;
			}
			.prose code {
				font-family: var(--font-mono);
				background: rgba(255, 255, 255, 0.06);
				padding: 0.15em 0.4em;
				border-radius: 4px;
				font-size: 0.92em;
			}
			.prose pre {
				background: #0a0d16;
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 12px;
				padding: 1.25em;
				overflow-x: auto;
			}
			.prose pre code {
				background: transparent;
				padding: 0;
			}
			.prose img {
				border-radius: 12px;
				border: 1px solid rgba(255, 255, 255, 0.08);
			}
			.prose hr {
				border: none;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
				margin: 2.5em 0;
			}
		</style>
	</body>
</html>
